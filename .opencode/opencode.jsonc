{
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "nvidia": {
      "api": "openai",
      "name": "NVIDIA API",
      "options": {
        "apiKey": "${NVIDIA_API_KEY}",
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "stepfun-ai/step-3.7-flash": {},
        "qwen/qwen3-coder-480b-a35b-instruct": {}
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}